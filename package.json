{
  "name": "@pkubangbang/crossroad-detector",
  "version": "0.1.1",
  "description": "Semantic crossroad (turning-word) detector for mycc — ONNX DistilBERT server + client SDK, with training harness.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "model/"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "fetch-model": "node scripts/fetch-model.mjs",
    "prepublishOnly": "npm run build",
    "test": "echo 'no tests yet' && exit 0"
  },
  "license": "MIT",
  "author": "pkubangbang <pkubangbang@pku.edu.cn>",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pkubangbang/crossroad-detector.git"
  },
  "dependencies": {
    "onnxruntime-node": "^1.29.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}